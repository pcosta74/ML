    "import tensorflow as tf\n",
    "from tensorflow.keras import Sequential, layers\n",
    "\n",
    "inputs = ['sugars', 'fiber', 'protein']\n",
    "outputs = ['calories']\n",
    "\n",
    "# Create a network with 1 linear unit\n",
    "model = Sequential([\n",
    "    layers.Input(shape=(len(inputs),)),\n",
    "    layers.Dense(len(outputs))\n",
    "])"
